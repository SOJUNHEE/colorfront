# Game server (apps/server)
PORT=2567
# 0.0.0.0 on a host/container; 127.0.0.1 for local development
HOST=127.0.0.1
# Development only: add artificial latency (ms) to every message
SIMULATE_LATENCY_MS=0

# ── Deployment (all optional locally) ──────────────────────────────────────
# NODE_ENV=production closes /metrics unless METRICS_TOKEN is set.
# NODE_ENV=production
# Serve the built client from the game server (same origin → wss through the platform TLS).
# STATIC_DIR=apps/client/dist
# Comma-separated browser origins allowed to open the game socket / matchmake. Empty = allow all.
# The server's own host is always allowed.
# ALLOWED_ORIGINS=https://colorfront.onrender.com
# Token for GET /metrics (Authorization: Bearer <token> or ?token=<token>).
# METRICS_TOKEN=

# Client (apps/client) — WebSocket endpoint of the game server.
# Unset in production = same origin as the page.
VITE_SERVER_URL=ws://localhost:2567
